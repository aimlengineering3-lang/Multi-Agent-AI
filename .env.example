# Copy to .env and fill in. Every key below is FREE (no credit card).
# You only need ONE key to run; more keys = automatic fallback if one is rate-limited.

# https://console.groq.com/keys           (very fast Llama 3.3 70B)
GROQ_API_KEY=
# https://aistudio.google.com/apikey      (Gemini, generous free tier)
GEMINI_API_KEY=
# https://openrouter.ai/keys              (many ":free" models)
OPENROUTER_API_KEY=
# https://cloud.cerebras.ai               (optional, fast Llama)
CEREBRAS_API_KEY=

# https://app.tavily.com                  (web search for grounded answers; 1,000 free credits/month)
TAVILY_API_KEY=

# --- Optional overrides (defaults live in config.py) ---
# Provider order per role. Cross-model review (a different model than the writer)
# catches more errors than a model reviewing its own output.
# GENERATOR_PROVIDERS=groq,gemini,openrouter,cerebras
# REVIEWER_PROVIDERS=gemini,groq,openrouter,cerebras
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-flash-latest
# MAX_ITERATIONS=3
